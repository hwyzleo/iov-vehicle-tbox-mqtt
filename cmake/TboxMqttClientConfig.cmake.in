@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# framework-ipc is a private dependency of the client library at build time,
# but the static library archives the symbols. Callers only need the public
# headers and the client library itself.

include("${CMAKE_CURRENT_LIST_DIR}/TboxMqttClientTargets.cmake")

check_required_components(TboxMqttClient)
